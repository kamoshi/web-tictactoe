{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "ttt-api",
      "image": "818571164127.dkr.ecr.us-east-1.amazonaws.com/ttt-backend",
      "hostname": "ttt-api",
      "essential": true,
      "portMappings": [
        {
          "hostPort": 7135,
          "containerPort": 7135
        }
      ],
      "memory": 512,
      "environment": [
        {
          "name": "DB_CONNECTION_STRING",
          "value": "Host=database;Port=5432;Username=postgres;Password=postgres;Database=tictactoe"
        }
      ]
    },
    {
      "name": "ttt-web",
      "image": "818571164127.dkr.ecr.us-east-1.amazonaws.com/ttt-frontend",
      "hostname": "ttt-web",
      "essential": true,
      "portMappings": [
        {
          "hostPort": 8080,
          "containerPort": 8080
        }
      ],
      "memory": 256
    },
    {
      "name": "router",
      "image": "818571164127.dkr.ecr.us-east-1.amazonaws.com/ttt-router",
      "hostname": "router",
      "essential": true,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 80
        }
      ],
      "links": ["ttt-web", "ttt-api"],
      "memory": 128
    }
  ]
}
